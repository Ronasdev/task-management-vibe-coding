NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://localhost:27017/taskflow
# Générez des secrets forts : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Origines autorisées (séparées par des virgules)
CORS_ORIGIN=http://localhost:5173
# Nombre de reverse proxies devant l API (1 derrière nginx)
TRUST_PROXY=0
