# Variables utilisées par docker-compose.yml (copiez ce fichier en .env)
# Générez chaque secret avec : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# URL publique de l'application (origine autorisée par CORS)
PUBLIC_URL=http://localhost:8080
# Port exposé sur la machine hôte
WEB_PORT=8080

# Cookie de session "Secure" (HTTPS requis). Mettre false uniquement pour un test en HTTP hors localhost.
COOKIE_SECURE=true
# Nombre de reverse proxies devant l'API (1 = Nginx seul)
TRUST_PROXY=1
